# CESFAM Agendamiento - Variables de Entorno

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://cesfam_user:password@localhost:5432/cesfam"

# NextAuth.js - Secreto para firmar tokens
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-aleatorio-aqui"

# NextAuth.js - URL de la aplicación
# En desarrollo: http://localhost:3000
# En producción: tu dominio público
NEXTAUTH_URL="http://localhost:3000"

# Dominio público usado en los links de los correos
APP_URL="http://localhost:3000"

# API key de Resend para los emails (opcional; sin ella no se envían correos)
RESEND_API_KEY=""

# Entorno (development | production)
NODE_ENV="development"
